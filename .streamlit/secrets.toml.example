# Copy to .streamlit/secrets.toml for local use, or paste into the
# "Advanced settings -> Secrets" box when deploying on Streamlit Community Cloud.
#
# Leaving these blank is fine: the app lets each visitor paste their own keys
# into the sidebar, which is the right choice for a public demo.

GEMINI_API_KEY = ""
NEBIUS_API_KEY = ""

# Weaviate Cloud cluster (Streamlit Cloud cannot reach a local Docker instance).
# If unset, the app falls back to an in-memory vector store per session.
WEAVIATE_URL = ""
WEAVIATE_API_KEY = ""
