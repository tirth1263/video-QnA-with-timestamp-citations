# Copy to .streamlit/secrets.toml for local use, or paste into
# "Settings -> Secrets" when deploying on Streamlit Community Cloud.
#
# Every key here is optional. Whatever you omit, the app asks the visitor for
# in the sidebar; whatever you provide, it uses silently. That lets you choose
# how much of a public demo you are willing to pay for.
#
#   ship nothing   -> visitors bring both keys
#   ship Nebius    -> visitors bring only Gemini (recommended for public demos:
#                     answering is cheap, embedding is the expensive half)
#   ship both      -> works instantly for anyone, and every visitor's usage
#                     is billed to you

# Answering. Cheap: a handful of tokens per question.
NEBIUS_API_KEY = ""

# Embedding + clip descriptions. This is the costly one - a 10-minute video at
# 20s clips is ~60 API calls from a single visitor, one time.
GEMINI_API_KEY = ""

# Weaviate Cloud cluster (hosted platforms cannot reach a local Docker
# instance). If unset, the app falls back to an in-memory store per session.
WEAVIATE_URL = ""
WEAVIATE_API_KEY = ""
